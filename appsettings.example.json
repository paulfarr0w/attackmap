{
  // Copy this file to appsettings.json (next to the program) and fill it in.
  // Comments like this one are allowed.

  "Imap": {
    "Host": "mail.example.com",
    "Port": 993,
    // Auto, SslOnConnect (port 993), StartTls (port 143), StartTlsWhenAvailable, or None
    "Security": "SslOnConnect",
    // Only set true for a home mail server with a self-signed certificate
    "AcceptInvalidCertificate": false,
    "Username": "you@example.com",
    // Or leave empty and set the ATTACKMAP_IMAP_PASSWORD environment variable instead
    "Password": "",
    "Folder": "INBOX",
    // The address fail2ban sends from (matched as "contains", so part of it is fine)
    "SenderFilter": "fail2ban@yourserver.com",
    // Optional: only look at emails whose subject contains this
    "SubjectFilter": ""
  },

  // Relative paths are relative to this file
  "GeoIpDatabase": "dbip-country-lite.mmdb",
  "StateFile": "attackmap-state.json",
  "OutputFile": "/var/www/html/attacks/index.html",

  "Title": "Who is attacking my server",
  "TopIpCount": 25,
  "TopCountryCount": 15,
  // light, dark, or auto (follows the visitor's system setting)
  "Theme": "light",

  // DB-IP's free database requires this credit line; for MaxMind GeoLite2 use
  // "IP geolocation by MaxMind GeoLite2" and "https://www.maxmind.com"
  "GeoIpAttribution": "IP geolocation by DB-IP",
  "GeoIpAttributionUrl": "https://db-ip.com",

  // Addresses to leave out of the stats, e.g. your own if you lock yourself out
  "IgnoreIps": []
}
